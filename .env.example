# Use either ETSY_API_KEY or the ETSY_KEYSTRING/ETSY_SHARED_SECRET pair.
ETSY_API_KEY=your_keystring:your_shared_secret
# ETSY_KEYSTRING=your_keystring
# ETSY_SHARED_SECRET=your_shared_secret

# Firecrawl Cloud or a compatible self-hosted endpoint.
FIRECRAWL_API_KEY=fc-your-api-key
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
# RUN_FIRECRAWL_LIVE=1
